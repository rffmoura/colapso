{
  "name": "colapso-workspace",
  "private": true,
  "version": "0.1.0",
  "engines": {
    "node": ">=20.19.4"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev -w @colapso/web",
    "dev:web": "npm run dev -w @colapso/web",
    "dev:native": "npm run start -w @colapso/native",
    "dev:native:device": "npm run start:device -w @colapso/native",
    "ios:native": "npm run ios -w @colapso/native",
    "ios:native:device": "npm run ios:device -w @colapso/native",
    "doctor:native": "npm run doctor -w @colapso/native",
    "export:native": "npm run export:ios -w @colapso/native",
    "build": "npm run build -w @colapso/web",
    "test": "npm run test --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present"
  },
  "devDependencies": {
    "expo-asset": "55.0.18",
    "expo-constants": "55.0.17",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "react-native": "0.83.6",
    "react-test-renderer": "19.2.0"
  },
  "overrides": {
    "expo-asset": "55.0.18",
    "expo-constants": "55.0.17",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "react-native": "0.83.6"
  }
}
